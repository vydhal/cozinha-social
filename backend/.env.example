# ========================
# Mesa do Bem — Backend
# ========================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Banco de Dados
DATABASE_URL="postgresql://mesadobem:senha_segura@localhost:5432/mesadobem?schema=public"

# JWT
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui
JWT_REFRESH_SECRET=sua_chave_refresh_secreta_muito_longa_e_segura_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Face Service
FACE_SERVICE_URL=http://face-service:8000

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate Limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Logs
LOG_LEVEL=info
