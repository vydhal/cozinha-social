# ============================================================================
# Variáveis da stack cozinha.elobase.tech (definir no Portainer → Environment)
# GERAR SEGREDOS NOVOS — nunca reaproveitar os do servidor antigo.
# Gerar um segredo forte:  openssl rand -hex 32
# ============================================================================

# --- Banco (senha nova; o dump é restaurado no MESMO db/user: mesadobem) ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# --- JWT (gerar novos) ---
JWT_SECRET=troque-openssl-rand-hex-32
JWT_REFRESH_SECRET=troque-openssl-rand-hex-32

# --- Superadmin / bootstrap ---
# ATENÇÃO: numa migração com restore, o superadmin de PRODUÇÃO (com a senha
# atual) volta pelo dump; este ADMIN_PASSWORD só valeria num banco vazio.
ADMIN_PASSWORD=defina-uma-senha
NOME_COZINHA=Cozinha Solidária Santa Rosa
LIMITE_DIARIO=100

# Migração = dados reais restaurados → manter false (não criar dados demo)
SEED_DEMO_DATA=false

# --- Integração máquina-a-máquina (gerar nova) ---
INTEGRATION_API_KEY=troque-openssl-rand-hex-32

# --- Tags das imagens (Docker Hub). Confirme que existem no Hub. ---
BACKEND_TAG=1.1.0
FRONTEND_TAG=1.1.0
FACE_TAG=1.1.0

# --- Acurácia facial (opcional; deixe em branco p/ usar os defaults) ---
FACE_MATCH_THRESHOLD=0.5
FACE_MATCH_MARGIN=0.06
